# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Supabase — get from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Worker proxy URL (optional — AI summaries fall back to direct if omitted)
VITE_PROXY_URL=https://feedbox-proxy.your-subdomain.workers.dev

# ⚠️  SECURITY: Anthropic API keys MUST NEVER be exposed in frontend code.
# AI summaries are called via Supabase Edge Functions (server-side) only.
# Do NOT set VITE_ANTHROPIC_KEY in production — keep keys server-side.
# For self-hosted deployments, configure the Edge Function secret directly in Supabase.
# VITE_ variables are bundled into the frontend JS and visible to users.
# Reference: supabase/functions/summarize/ for server-side configuration.
